# {{ ansible_managed }}
# Настройки окружения {{ env_name }}. Хранятся только на сервере (не в образе).
# Пароль берётся из зашифрованного vault.yml.
POSTGRES_USER={{ app_postgres_user }}
POSTGRES_PASSWORD={{ app_postgres_password }}
POSTGRES_DB={{ app_postgres_db }}
APP_PORT={{ app_port }}
APP_BIND={{ app_bind }}
ENVIRONMENT={{ env_name }}
APP_MEM_LIMIT={{ app_mem_limit }}
