# ЛР8: настройки стека наблюдаемости. Скопируйте в monitoring/.env и задайте пароль.
# monitoring/.env в git не попадает (.gitignore).

# Пароль администратора Grafana (пользователь admin).
GRAFANA_ADMIN_PASSWORD=замените-на-длинный-пароль

# Сеть приложения: <compose-проект>_frontend. Локально (make container-up) —
# city-duma_frontend; на staging — city-duma-staging_frontend.
APP_NETWORK=city-duma_frontend

# На каком адресе хоста открыть Grafana и Prometheus. 127.0.0.1 — только с
# самой машины; 0.0.0.0 — из сети (на серверах доступ ограничивает firewall).
MONITORING_BIND=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
