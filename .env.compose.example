# Настройки контейнерного окружения (ЛР4). Файл .env.compose в git не попадает.
# Создаётся командой make container-init (пароль генерируется случайный).
POSTGRES_USER=duma
POSTGRES_PASSWORD=замените_на_свой_пароль
POSTGRES_DB=city_duma
# Порт и адрес публикации приложения на хосте
APP_PORT=8000
APP_BIND=127.0.0.1
ENVIRONMENT=container
